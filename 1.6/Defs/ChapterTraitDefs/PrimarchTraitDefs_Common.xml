<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <!-- Trait options for player-designed primarch lineages (kind Primarch). stabilityOffset is read as Genetic Complexity:
         perks negative, drawbacks positive; the total shifts the growth vat's gestation time (see BEWH_CustomPrimarchGene). -->

    <!-- ===================== Default perks ===================== -->

    <Genes40k.ChapterTraitDef>
        <defName>BEWH_PrimarchTrait_Towering</defName>
        <label>Towering Frame</label>
        <description>The lineage runs to a frame even other primarchs look up at. More muscle, more reach, more to carry.</description>
        <iconPath>UI/GeneTraits/Common/BEWH_ChapterTrait_StalwartIcon</iconPath>
        <displayOrder>1101</displayOrder>
        <kind>Primarch</kind>
        <stabilityOffset>-2</stabilityOffset>
        <statOffsets>
            <VEF_BodySize_Offset>0.1</VEF_BodySize_Offset>
            <CarryingCapacity>50</CarryingCapacity>
        </statOffsets>
    </Genes40k.ChapterTraitDef>

    <Genes40k.ChapterTraitDef>
        <defName>BEWH_PrimarchTrait_Tireless</defName>
        <label>Tireless</label>
        <description>Sleep is a courtesy this lineage extends to itself rarely, and works through the difference.</description>
        <iconPath>UI/GeneTraits/Common/BEWH_ChapterTrait_Tireless</iconPath>
        <displayOrder>1102</displayOrder>
        <kind>Primarch</kind>
        <stabilityOffset>-1</stabilityOffset>
        <exclusionTags>
            <li>BEWH_PrimarchTrait_Work</li>
        </exclusionTags>
        <statFactors>
            <RestFallRateFactor>0.85</RestFallRateFactor>
            <WorkSpeedGlobal>1.05</WorkSpeedGlobal>
        </statFactors>
    </Genes40k.ChapterTraitDef>

    <Genes40k.ChapterTraitDef>
        <defName>BEWH_PrimarchTrait_Commanding</defName>
        <label>Commanding Presence</label>
        <description>Rooms quieten when this lineage enters them. Bargains go its way more often than not.</description>
        <iconPath>UI/GeneTraits/Common/BEWH_ChapterTrait_Loremasters</iconPath>
        <displayOrder>1103</displayOrder>
        <kind>Primarch</kind>
        <stabilityOffset>-1</stabilityOffset>
        <exclusionTags>
            <li>BEWH_PrimarchTrait_Social</li>
        </exclusionTags>
        <statFactors>
            <SocialImpact>1.15</SocialImpact>
        </statFactors>
        <statOffsets>
            <NegotiationAbility>0.3</NegotiationAbility>
        </statOffsets>
    </Genes40k.ChapterTraitDef>

    <Genes40k.ChapterTraitDef>
        <defName>BEWH_PrimarchTrait_Quickened</defName>
        <label>Quickened</label>
        <description>Long legs and a short fuse between thought and motion.</description>
        <iconPath>UI/GeneTraits/Common/BEWH_ChapterTrait_Swift</iconPath>
        <displayOrder>1104</displayOrder>
        <kind>Primarch</kind>
        <stabilityOffset>-1</stabilityOffset>
        <exclusionTags>
            <li>BEWH_PrimarchTrait_Speed</li>
        </exclusionTags>
        <statOffsets>
            <MoveSpeed>0.3</MoveSpeed>
        </statOffsets>
    </Genes40k.ChapterTraitDef>

    <Genes40k.ChapterTraitDef>
        <defName>BEWH_PrimarchTrait_Sharpened</defName>
        <label>Sharpened Instincts</label>
        <description>A predator's read of an opponent, inherited rather than learned.</description>
        <iconPath>UI/GeneTraits/Common/BEWH_ChapterTrait_LightningReflexes</iconPath>
        <displayOrder>1105</displayOrder>
        <kind>Primarch</kind>
        <stabilityOffset>-2</stabilityOffset>
        <exclusionTags>
            <li>BEWH_PrimarchTrait_Dodge</li>
        </exclusionTags>
        <statOffsets>
            <MeleeDodgeChance>3</MeleeDodgeChance>
            <MeleeHitChance>1</MeleeHitChance>
        </statOffsets>
    </Genes40k.ChapterTraitDef>

    <!-- ===================== Default drawbacks ===================== -->

    <Genes40k.ChapterTraitDef>
        <defName>BEWH_PrimarchTrait_Plain</defName>
        <label>Unremarkable Lineage</label>
        <description>A plain, well-behaved template with no quirks to speak of. The vat appreciates it more than the primarch will.</description>
        <iconPath>UI/GeneTraits/Common/BEWH_ChapterTrait_Unremarkable</iconPath>
        <displayOrder>1201</displayOrder>
        <kind>Primarch</kind>
        <stabilityOffset>1</stabilityOffset>
    </Genes40k.ChapterTraitDef>

    <Genes40k.ChapterTraitDef>
        <defName>BEWH_PrimarchTrait_Slothful</defName>
        <label>Slow to Wake</label>
        <description>Genius arrives in this lineage, but late, and only after it has had breakfast.</description>
        <iconPath>UI/GeneTraits/Common/BEWH_ChapterTrait_DimLineage</iconPath>
        <displayOrder>1202</displayOrder>
        <kind>Primarch</kind>
        <stabilityOffset>1</stabilityOffset>
        <exclusionTags>
            <li>BEWH_PrimarchTrait_Work</li>
        </exclusionTags>
        <statFactors>
            <WorkSpeedGlobal>0.9</WorkSpeedGlobal>
            <GlobalLearningFactor>0.9</GlobalLearningFactor>
        </statFactors>
    </Genes40k.ChapterTraitDef>

    <Genes40k.ChapterTraitDef>
        <defName>BEWH_PrimarchTrait_Aloof</defName>
        <label>Aloof</label>
        <description>This lineage does not suffer mortals gladly, and lets them know it.</description>
        <iconPath>UI/GeneTraits/Common/BEWH_ChapterTrait_ColdForged</iconPath>
        <displayOrder>1203</displayOrder>
        <kind>Primarch</kind>
        <stabilityOffset>1</stabilityOffset>
        <exclusionTags>
            <li>BEWH_PrimarchTrait_Social</li>
        </exclusionTags>
        <statFactors>
            <SocialImpact>0.8</SocialImpact>
        </statFactors>
        <forcedTraits>
            <li>
                <def>Abrasive</def>
            </li>
        </forcedTraits>
    </Genes40k.ChapterTraitDef>

    <Genes40k.ChapterTraitDef>
        <defName>BEWH_PrimarchTrait_Brittle</defName>
        <label>Brittle Frame</label>
        <description>The bones set fast and set badly. Blows land harder than a primarch's should.</description>
        <iconPath>UI/GeneTraits/Common/BEWH_ChapterTrait_BrittleBones</iconPath>
        <displayOrder>1204</displayOrder>
        <kind>Primarch</kind>
        <stabilityOffset>2</stabilityOffset>
        <statFactors>
            <IncomingDamageFactor>1.1</IncomingDamageFactor>
        </statFactors>
    </Genes40k.ChapterTraitDef>

</Defs>