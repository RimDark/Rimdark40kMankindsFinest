        <defaultShowRotation>
            <li>North</li>
            <li>East</li>
            <li>South</li>
        </defaultShowRotation>
        <appliesTo>
            <li>BEWH_MkVIIPowerArmor</li>
            <li>BEWH_MkXPowerArmor</li>
        </appliesTo>
        <drawData>
            <scaleOffsetByBodySize>true</scaleOffsetByBodySize>
            <dataNorth>
                <layer>88.5</layer>
            </dataNorth>
            <dataSouth>
                <layer>65</layer>
            </dataSouth>
            <dataEast>
                <layer>64</layer>
            </dataEast>
            <dataWest>
                <layer>64</layer>
                <flip>true</flip>
            </dataWest>
        </drawData>
        <flipable>true</flipable>
        <decorationType>BEWH_DecoCategory_Grenades</decorationType>
        <givesVFEAbilities>
            <li>BEWH_Ability_ThrowFragGrenade</li>
        </givesVFEAbilities>
        <incompatibleDecorations>
            <li>BEWH_Deco_Grenade_2</li>
            <li>BEWH_Deco_KrGrenade_1</li>
            <li>BEWH_Deco_KrGrenade_2</li>
        </incompatibleDecorations>
        <cost>
            <Steel>20</Steel>
            <ComponentIndustrial>1</ComponentIndustrial>
        </cost>
        <workAmount>900</workAmount>
    </Core40k.ExtraDecorationDef>

