<Defs>

    <!-- Grenades -->
    <Core40k.ExtraDecorationDef>
        <defName>BEWH_Deco_Grenade_1</defName>
        <label>Grenade 1</label>
        <description>...</description>
        <iconPath>UI/Decoration/Icons/Astartes/Armor/BEWH_Deco_Grenade1_icon</iconPath>
        <drawnTextureIconPath>Things/Decorations/Armor/Common/Grenades/BEWH_Deco_Grenade1</drawnTextureIconPath>
