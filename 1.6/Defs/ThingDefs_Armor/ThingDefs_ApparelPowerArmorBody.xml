    <!-- ===== IMPERIUM ===== -->
    <!-- MK 7 -->
    <ThingDef ParentName="BEWH_PowerArmorBase_ChapterColour">
        <defName>BEWH_MkVIIPowerArmor</defName>
        <tickerType>Normal</tickerType>
        <label>Mk VII Power Armor</label>
        <description>The MK VII "Aquila" Power Armor is an advanced battle plate worn by the Adeptus Astartes. It features dense ceramite plating, reinforced servo-musculature, and the iconic Aquila chest plate. It provides excellent protection against ballistic and energy weapons, making it ideal for prolonged engagements in hostile environments.</description>
        <recipeMaker>
            <researchPrerequisite>BEWH_PowerArmorMkVII</researchPrerequisite>
        </recipeMaker>
        <graphicData>
            <texPath>Things/Armor/Imperium/PowerArmor/MkVIIPowerArmor/BEWH_MkVIIPowerArmor</texPath>
        </graphicData>
        <statBases>
            <WorkToMake>75000</WorkToMake>
            <MarketValue>8000</MarketValue>

            <ArmorRating_Sharp>1.56</ArmorRating_Sharp>
            <ArmorRating_Blunt>0.65</ArmorRating_Blunt>
            <ArmorRating_Heat>1</ArmorRating_Heat>

            <Insulation_Cold>36</Insulation_Cold>
            <Insulation_Heat>20</Insulation_Heat>

            <BEWH_InternalUpgradeSlots>4</BEWH_InternalUpgradeSlots>
            <!-- Zero unless a fitted conversion field raises it; the StatDef default is 1. -->
            <EnergyShieldEnergyMax>0</EnergyShieldEnergyMax>
            <EnergyShieldRechargeRate>0</EnergyShieldRechargeRate>
        </statBases>
        <equippedStatOffsets>
            <TerrorSource MayRequire="Ludeon.RimWorld.Ideology">17</TerrorSource>
            <VacuumResistance MayRequire="Ludeon.RimWorld.Odyssey">0.28</VacuumResistance>
        </equippedStatOffsets>
        <costList>
            <ComponentSpacer>6</ComponentSpacer>
            <Plasteel>150</Plasteel>
            <Uranium>50</Uranium>
        </costList>
        <apparel>
            <wornGraphicPath>Things/Armor/Imperium/PowerArmor/MkVIIPowerArmor/BEWH_MkVIIPowerArmor</wornGraphicPath>
            <tags>
                <li>BEWH_PowerArmorMkVII</li>
            </tags>
            <renderNodeProperties>
                <!-- Backpacks -->
                <li>
                    <workerClass>Core40k.PawnRenderNodeWorker_AttachmentBackpack</workerClass>
                    <nodeClass>Core40k.PawnRenderNode_FlagEdit</nodeClass>
                    <texPath>Things/Armor/Imperium/PowerArmor/MkVIIPowerArmor/Backpacks/BEWH_MkVIIPowerArmor_Backpack</texPath>
                    <shaderTypeDef>CutoutComplex</shaderTypeDef>
                    <parentTagDef>Body</parentTagDef>
                    <drawData>
                        <dataEast>
                            <layer>71</layer>
                        </dataEast>
                        <dataWest>
                            <layer>71</layer>
                        </dataWest>
                        <dataNorth>
                            <layer>99.6</layer>
                        </dataNorth>
                        <dataSouth>
                            <layer>-1</layer>
                        </dataSouth>
                    </drawData>
                    <texSeed>1</texSeed>
                </li>
                <!-- Shoulder pad -->
                <li>
                    <workerClass>Core40k.PawnRenderNodeWorker_AttachmentShoulderPad</workerClass>
                    <nodeClass>Core40k.PawnRenderNode_FlagEdit</nodeClass>
                    <texPath>Things/Armor/Imperium/PowerArmor/MkVIIPowerArmor/Shoulder/BEWH_MkVIIPowerArmor_Shoulder</texPath>
                    <shaderTypeDef>CutoutComplex</shaderTypeDef>
                    <parentTagDef>Body</parentTagDef>
                    <drawData>
                        <dataEast>
                            <layer>72</layer>
                        </dataEast>
                        <dataWest>
                            <layer>72</layer>
                        </dataWest>
                    </drawData>
                    <texSeed>2</texSeed>
                </li>
            </renderNodeProperties>
        </apparel>
        <comps>
            <li Class="Core40k.CompProperties_ConversionField" />
            <li Class="Genes40k.CompProperties_ChapterColorWithShoulderDecoration" />
            <li Class="Core40k.CompProperties_Decorative">
                <drawRenderNodesOnGround>true</drawRenderNodesOnGround>
                <decorations>
                    <li>BEWH_Deco_ChestAquila</li>
                </decorations>
            </li>
        </comps>
        <modExtensions>
            <li Class="Core40k.DefModExtension_ForcesBodyType">
                <forcedBodyType>Hulk</forcedBodyType>
                <hideBodyGraphic>true</hideBodyGraphic>
            </li>
            <li Class="Core40k.DefModExtension_TextureFlags">
                <maskExpansions>
                    <li>
                        <identifier>1</identifier>
                        <pathExpansionOnMask>_Backpack</pathExpansionOnMask>
                        <maskDefsWithExpansion>
                            <li>BEWH_MkVIIArmorHalvedMask</li>
                            <li>BEWH_MkVIIArmorCheckeredMask</li>
                        </maskDefsWithExpansion>
                    </li>
                    <li>
                        <identifier>2</identifier>
                        <pathExpansionOnMask>_Shoulder</pathExpansionOnMask>
                        <maskDefsWithExpansion>
                            <li>BEWH_MkVIIArmorPauldronsMask</li>
                            <li>BEWH_MkVIIArmorHalvedMask</li>
                            <li>BEWH_MkVIIArmorCheckeredMask</li>
                        </maskDefsWithExpansion>
                    </li>
                </maskExpansions>
            </li>
        </modExtensions>
    </ThingDef>

