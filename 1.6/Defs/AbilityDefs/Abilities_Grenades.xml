<?xml version="1.0" encoding="UTF-8"?>
<Defs>

	<VEF.Abilities.AbilityDef Name="BEWH_ThrowGrenadeBase" Abstract="True">
		<abilityClass>VEF.Abilities.Ability_ShootProjectile</abilityClass>
		<castTime>30</castTime>
		<range>12.9</range>
		<targetMode>Location</targetMode>
		<targetingParameters>
			<canTargetPawns>true</canTargetPawns>
			<canTargetBuildings>true</canTargetBuildings>
			<canTargetLocations>true</canTargetLocations>
		</targetingParameters>
	</VEF.Abilities.AbilityDef>

	<VEF.Abilities.AbilityDef ParentName="BEWH_ThrowGrenadeBase">
		<defName>BEWH_Ability_ThrowFragGrenade</defName>
		<label>throw frag grenade</label>
		<description>Pull the pin and put a fragmentation grenade where it will do the most good. The suit carries one charge at a time; the armoury replaces it between engagements.</description>
		<iconPath>UI/Abilities/BEWH_Ability_Grenade</iconPath>
		<cooldownTime>15000</cooldownTime>
		<modExtensions>
			<li Class="VEF.Abilities.AbilityExtension_Projectile">
				<projectile>Proj_GrenadeFrag</projectile>
			</li>
		</modExtensions>
	</VEF.Abilities.AbilityDef>

	<VEF.Abilities.AbilityDef ParentName="BEWH_ThrowGrenadeBase">
		<defName>BEWH_Ability_ThrowKrakGrenade</defName>
		<label>throw krak grenade</label>
		<description>A shaped charge meant for armour and bunkers rather than men. A tight blast that goes through what it touches.</description>
		<iconPath>UI/Abilities/BEWH_Ability_KrakGrenade</iconPath>
		<cooldownTime>20000</cooldownTime>
		<modExtensions>
			<li Class="VEF.Abilities.AbilityExtension_Projectile">
				<projectile>BEWH_Proj_KrakGrenade</projectile>
			</li>
		</modExtensions>
	</VEF.Abilities.AbilityDef>

	<VEF.Abilities.AbilityDef ParentName="BEWH_ThrowGrenadeBase">
		<defName>BEWH_Ability_ThrowFragGrenadePair</defName>
		<label>throw frag grenade</label>
		<description>Pull the pin and put a fragmentation grenade where it will do the most good. The suit carries a pair of charges; the armoury replaces them between engagements.</description>
		<iconPath>UI/Abilities/BEWH_Ability_Grenade</iconPath>
		<abilityClass>Core40k.Ability_ShootProjectileWithCharges</abilityClass>
		<gizmoClass>Core40k.Command_AbilityWithCharges</gizmoClass>
		<cooldownTime>15000</cooldownTime>
		<modExtensions>
			<li Class="VEF.Abilities.AbilityExtension_Projectile">
				<projectile>Proj_GrenadeFrag</projectile>
			</li>
			<li Class="Core40k.DefModExtension_AbilityCharges">
				<maxCharges>2</maxCharges>
			</li>
		</modExtensions>
	</VEF.Abilities.AbilityDef>

	<VEF.Abilities.AbilityDef ParentName="BEWH_ThrowGrenadeBase">
		<defName>BEWH_Ability_ThrowKrakGrenadePair</defName>
		<label>throw krak grenade</label>
		<description>A shaped charge meant for armour and bunkers rather than men. A tight blast that goes through what it touches. The suit carries a pair of charges.</description>
		<iconPath>UI/Abilities/BEWH_Ability_KrakGrenade</iconPath>
		<abilityClass>Core40k.Ability_ShootProjectileWithCharges</abilityClass>
		<gizmoClass>Core40k.Command_AbilityWithCharges</gizmoClass>
		<cooldownTime>20000</cooldownTime>
		<modExtensions>
			<li Class="VEF.Abilities.AbilityExtension_Projectile">
				<projectile>BEWH_Proj_KrakGrenade</projectile>
			</li>
			<li Class="Core40k.DefModExtension_AbilityCharges">
				<maxCharges>2</maxCharges>
			</li>
		</modExtensions>
	</VEF.Abilities.AbilityDef>

</Defs>