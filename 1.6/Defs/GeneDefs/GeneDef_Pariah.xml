        <biostatCpx>3</biostatCpx>
        <biostatMet>-1</biostatMet>
        <statFactors>
            <PsychicSensitivity>0.2</PsychicSensitivity>
            <MeditationFocusGain>0.2</MeditationFocusGain>
            <PsychicEntropyRecoveryRate>0.2</PsychicEntropyRecoveryRate>
        </statFactors>
        <customEffectDescriptions>
            <li>Greatly reduces psychic sensitivity of nearby pawns and self.</li>
        </customEffectDescriptions>
        <minAgeActive>6</minAgeActive>
        <marketValueFactor>1.8</marketValueFactor>
        <selectionWeight>0.3</selectionWeight>
        <modExtensions>
            <li Class="VEF.Genes.GeneExtension">
                <backgroundPathXenogenes>UI/Genes/BEWH_GeneBackground_Pariah</backgroundPathXenogenes>
