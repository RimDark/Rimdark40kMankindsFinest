<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <!-- Sigma Pariah -->
    <GeneDef ParentName="BEWH_PariahParent">
        <defName>BEWH_SigmaPariah</defName>
        <label>sigma pariah</label>
        <description>Carriers of this gene have reduced psychic sensitivity. Additionally they slightly reduce the psychic sensitivity and consciousness of others nearby whilst also slightly increasing their pain.</description>
        <iconPath>UI/Genes/Pariah/BEWH_PariahSigma</iconPath>
        <displayOrderInCategory>700</displayOrderInCategory>
        <biostatCpx>1</biostatCpx>
        <biostatMet>-1</biostatMet>
        <statFactors>
            <PsychicSensitivity>0.55</PsychicSensitivity>
            <MeditationFocusGain>0.55</MeditationFocusGain>
            <PsychicEntropyRecoveryRate>0.55</PsychicEntropyRecoveryRate>
        </statFactors>
        <customEffectDescriptions>
            <li>Reduces psychic sensitivity of nearby pawns and self.</li>
        </customEffectDescriptions>
        <minAgeActive>6</minAgeActive>
        <marketValueFactor>1.2</marketValueFactor>
        <selectionWeight>0.7</selectionWeight>
        <modExtensions>
            <li Class="VEF.Genes.GeneExtension">
                <backgroundPathXenogenes>UI/Genes/BEWH_GeneBackground_Pariah</backgroundPathXenogenes>
            </li>
            <li Class="Genes40k.DefModExtension_Pariah">
                <radius>12</radius>
                <tier>1</tier>
                <pariahGene>BEWH_SigmaPariah</pariahGene>
                <naturalBornSelectionWeight>40</naturalBornSelectionWeight>
            </li>
        </modExtensions>
    </GeneDef>

