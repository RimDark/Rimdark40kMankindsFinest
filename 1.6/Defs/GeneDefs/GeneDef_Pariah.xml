    <!-- Omega Pariah -->
    <GeneDef ParentName="BEWH_PariahParent">
        <defName>BEWH_OmegaPariah</defName>
        <label>omega pariah</label>
        <description>Carriers of this gene have no psychic sensitivity. Additionally, they nullify the psychic sensitivity and reduce the consciousness of nearby pawns, while greatly increasing their pain.</description>
        <iconPath>UI/Genes/Pariah/BEWH_PariahOmega</iconPath>
        <displayOrderInCategory>702</displayOrderInCategory>
        <biostatCpx>5</biostatCpx>
        <biostatMet>-2</biostatMet>
        <statFactors>
            <PsychicSensitivity>0</PsychicSensitivity>
            <MeditationFocusGain>0</MeditationFocusGain>
            <PsychicEntropyRecoveryRate>0</PsychicEntropyRecoveryRate>
        </statFactors>
        <customEffectDescriptions>
            <li>Nullifies psychic sensitivity of nearby pawns and self.</li>
        </customEffectDescriptions>
        <minAgeActive>6</minAgeActive>
        <marketValueFactor>3</marketValueFactor>
        <canGenerateInGeneSet>false</canGenerateInGeneSet>
        <selectionWeight>0.05</selectionWeight>
        <modExtensions>
            <li Class="VEF.Genes.GeneExtension">
                <backgroundPathXenogenes>UI/Genes/BEWH_GeneBackground_Pariah</backgroundPathXenogenes>
            </li>
            <li Class="Genes40k.DefModExtension_Pariah">
                <radius>20</radius>
                <tier>3</tier>
                <pariahGene>BEWH_OmegaPariah</pariahGene>
                <naturalBornSelectionWeight>4</naturalBornSelectionWeight>
            </li>
        </modExtensions>
    </GeneDef>

</Defs>