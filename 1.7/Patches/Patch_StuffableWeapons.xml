<?xml version="1.0" encoding="utf-8"?>
<!-- Makes the Mankind's Finest proto-chainsword stuffable. Each piece keeps its old stats when made from its
     default material (its old main ingredient); other materials raise or lower armor or melee damage,
     hit points, work and flammability the vanilla way. The framework's DefModExtension_IgnoreStuffColor keeps
     the textures untinted with every material, and DefModExtension_FixedGenerationStuff makes
     generated pawns always get the default material. It can be switched off in VEF's mod settings
     (toggleable patches; needs a restart). Generated by notes/CodexRimperialisGrimWorld/gen_stuffable.py. -->
<Patch>

    <Operation Class="VEF.PatchOperationToggableSequence">
        <enabled>True</enabled>
        <label>Make the proto-chainsword stuffable:</label>
        <operations>

            <!-- BEWH_proto-Chainsword: Steel x72 (Metallic) -->
            <li Class="PatchOperationReplace">
                <xpath>Defs/ThingDef[defName="BEWH_proto-Chainsword"]/costList</xpath>
                <value>
                    <costList Inherit="False">
                        <Plasteel>8</Plasteel>
                        <ComponentIndustrial>6</ComponentIndustrial>
                    </costList>
                </value>
            </li>
            <li Class="PatchOperationAdd">
                <xpath>Defs/ThingDef[defName="BEWH_proto-Chainsword"]</xpath>
                <value>
                    <stuffCategories>
                        <li>Metallic</li>
                    </stuffCategories>
                    <costStuffCount>72</costStuffCount>
                    <defaultStuff>Steel</defaultStuff>
                </value>
            </li>
            <li Class="PatchOperationAdd">
                <xpath>Defs/ThingDef[defName="BEWH_proto-Chainsword"]/statBases</xpath>
                <value>
                    <Flammability>2.5</Flammability>
                </value>
            </li>

            <!-- Keep the original texture colours; generated pawns get the default material -->
            <li Class="PatchOperationAdd">
                <success>Always</success>
                <xpath>Defs/ThingDef[(defName="BEWH_proto-Chainsword") and not(modExtensions)]</xpath>
                <value>
                    <modExtensions />
                </value>
            </li>
            <li Class="PatchOperationAdd">
                <xpath>Defs/ThingDef[defName="BEWH_proto-Chainsword"]/modExtensions</xpath>
                <value>
                    <li Class="Core40k.DefModExtension_IgnoreStuffColor" />
                    <li Class="Core40k.DefModExtension_FixedGenerationStuff" />
                </value>
            </li>

        </operations>
    </Operation>

</Patch>
