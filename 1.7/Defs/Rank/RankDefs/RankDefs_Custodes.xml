<?xml version="1.0" encoding="UTF-8"?>
<Defs>

    <!-- ====Custodes==== -->
    <!-- =Command= -->
    <!-- Custodian Guard -->
    <Genes40k.ChapterRankDef>
        <defName>BEWH_CustodesRankCustodianGuard</defName>
        <label>Custodian Guard</label>
        <description>Every member of the Ten Thousand is a demigod of war, made one at a time by the Emperor's own art. A Custodian Guard has no need to prove himself the equal of a Space Marine. He has already surpassed them. He serves the Throne, and nothing else.</description>
        <rankIconPath>Placeholder</rankIconPath>
        <defaultFirstRank>True</defaultFirstRank>

        <requirements>
            <li Class="Core40k.PawnRequirement_Skills">
                <skills>
                    <Shooting>9</Shooting>
                    <Melee>9</Melee>
                </skills>
            </li>
            <li Class="Core40k.PawnRequirement_Genes">
                <genes>
                    <li>BEWH_ImmunisLeucocyte</li>
                    <li>BEWH_AthanaticVitae</li>
                    <li>BEWH_FulguriteNervePlexus</li>
                    <li>BEWH_AtlasMorphogen</li>
                    <li>BEWH_MnemosyneMindshield</li>
                    <li>BEWH_FulgurVitaliumstrand</li>
                </genes>
            </li>
        </requirements>

        <statOffsets>
            <MeleeDodgeChance>1</MeleeDodgeChance>
            <RangedCooldownFactor>-0.05</RangedCooldownFactor>
            <MeleeCooldownFactor>-0.05</MeleeCooldownFactor>
            <RestFallRateFactor>-0.05</RestFallRateFactor>
        </statOffsets>

        <rankTier>0</rankTier>
    </Genes40k.ChapterRankDef>
    <!-- Shield-Captain -->
    <Genes40k.ChapterRankDef>
        <defName>BEWH_CustodesRankShieldCaptain</defName>
        <label>Shield-Captain</label>
        <description>A Shield-Captain leads a Shield Host, a brotherhood of Custodians that might hold a world on its own. Each is a master strategist and a peerless duellist, trusted to judge when the Emperor's guardians must leave the Palace and make war.</description>
        <rankIconPath>Placeholder</rankIconPath>
        <colonyLimitOfRank>(3, 6)</colonyLimitOfRank>

        <requirements>
            <li Class="Core40k.PawnRequirement_Skills">
                <skills>
                    <Shooting>12</Shooting>
                    <Melee>12</Melee>
                </skills>
            </li>
        </requirements>

        <statOffsets>
            <MeleeDodgeChance>2</MeleeDodgeChance>
            <RangedCooldownFactor>-0.05</RangedCooldownFactor>
            <MeleeCooldownFactor>-0.05</MeleeCooldownFactor>
            <RestFallRateFactor>-0.05</RestFallRateFactor>
        </statOffsets>

        <rankTier>4</rankTier>
    </Genes40k.ChapterRankDef>
    <!-- Tribune -->
    <Genes40k.ChapterRankDef>
        <defName>BEWH_CustodesRankCaptainCommander</defName>
        <label>Tribune</label>
        <description>Tribunes stand above the Shield-Captains, commanding several Shield Hosts at once. Their word carries the weight of the Captain-General himself, and few in the Imperium would dare to question it.</description>
        <rankIconPath>Placeholder</rankIconPath>
        <colonyLimitOfRank>(2, 8)</colonyLimitOfRank>

        <requirements>
            <li Class="Core40k.PawnRequirement_Skills">
                <skills>
                    <Shooting>14</Shooting>
                    <Melee>14</Melee>
                    <Social>7</Social>
                    <Intellectual>5</Intellectual>
                </skills>
            </li>
        </requirements>

        <statOffsets>
            <RestFallRateFactor>-0.05</RestFallRateFactor>
        </statOffsets>

        <rankTier>6</rankTier>
    </Genes40k.ChapterRankDef>
    <!-- Captain-General -->
    <Genes40k.ChapterRankDef>
        <defName>BEWH_CustodesRankCaptainGeneral</defName>
        <label>Captain-General</label>
        <description>The Captain-General is the master of the Adeptus Custodes and the Emperor's chosen guardian. He answers to no High Lord, sits at no council but by choice, and holds the authority to strip any Custodian of his station.</description>
        <rankIconPath>Placeholder</rankIconPath>
        <colonyLimitOfRank>(1, 0)</colonyLimitOfRank>

        <requirements>
            <li Class="Core40k.PawnRequirement_Skills">
                <skills>
                    <Shooting>18</Shooting>
                    <Melee>18</Melee>
                    <Social>10</Social>
                    <Intellectual>8</Intellectual>
                </skills>
            </li>
        </requirements>

        <statOffsets>
            <RestFallRateFactor>-0.05</RestFallRateFactor>
            <SocialImpact>0.5</SocialImpact>
        </statOffsets>

        <givesAbilities>
            <li>BEWH_StripRanksCustodes</li>
        </givesAbilities>

        <rankTier>10</rankTier>
    </Genes40k.ChapterRankDef>

    <!-- =Battlefield roles= -->
    <!-- Sagittarum Guard -->
    <Genes40k.ChapterRankDef>
        <defName>BEWH_CustodesRankSagittarum</defName>
        <label>Sagittarum Guard</label>
        <description>Sagittarum Custodians hold the firing line with Adrasite and Pyrithite spears, picking apart the foe at range while their brothers close in. Where they stand, nothing reaches the line alive.</description>
        <rankIconPath>Placeholder</rankIconPath>

        <requirements>
            <li Class="Core40k.PawnRequirement_Skills">
                <skills><Shooting>12</Shooting></skills>
            </li>
            <li Class="Core40k.PawnRequirement_IncompatibleRanks">
                <ranks>
                    <li>BEWH_CustodesRankWarden</li>
                    <li>BEWH_CustodesRankVenatari</li>
                </ranks>
            </li>
        </requirements>

        <statOffsets>
            <ShootingAccuracyPawn>3</ShootingAccuracyPawn>
            <MeleeDodgeChance>-2</MeleeDodgeChance>
        </statOffsets>
        <statFactors>
            <AimingDelayFactor>0.9</AimingDelayFactor>
            <ShootingAccuracyFactor_Long>1.05</ShootingAccuracyFactor_Long>
        </statFactors>

        <rankTier>2</rankTier>

        <specialistRank>true</specialistRank>
    </Genes40k.ChapterRankDef>
    <!-- Custodian Warden -->
    <Genes40k.ChapterRankDef>
        <defName>BEWH_CustodesRankWarden</defName>
        <label>Custodian Warden</label>
        <description>Wardens are the gatekeepers of the Imperial Palace, wielding the Castellan axe. Once a Warden has chosen where to stand, no force in the galaxy will move him.</description>
        <rankIconPath>Placeholder</rankIconPath>

        <requirements>
            <li Class="Core40k.PawnRequirement_Skills">
                <skills><Melee>12</Melee></skills>
            </li>
            <li Class="Core40k.PawnRequirement_IncompatibleRanks">
                <ranks>
                    <li>BEWH_CustodesRankSagittarum</li>
                    <li>BEWH_CustodesRankVenatari</li>
                </ranks>
            </li>
        </requirements>

        <statOffsets>
            <ArmorRating_Sharp>0.05</ArmorRating_Sharp>
            <ArmorRating_Blunt>0.05</ArmorRating_Blunt>
            <MeleeDodgeChance>3</MeleeDodgeChance>
        </statOffsets>

        <givesHediffs>
            <BEWH_CustodesUnyielding>
                <initialSeverity>0.5</initialSeverity>
            </BEWH_CustodesUnyielding>
        </givesHediffs>

        <rankTier>2</rankTier>

        <specialistRank>true</specialistRank>
    </Genes40k.ChapterRankDef>
    <!-- Venatari -->
    <Genes40k.ChapterRankDef>
        <defName>BEWH_CustodesRankVenatari</defName>
        <label>Venatari</label>
        <description>The Venatari are the Custodes' hunters. Borne on jump packs, they fall upon the enemy's leaders and champions before the foe even knows the Ten Thousand have taken the field.</description>
        <rankIconPath>Placeholder</rankIconPath>

        <requirements>
            <li Class="Core40k.PawnRequirement_Skills">
                <skills>
                    <Melee>10</Melee>
                    <Shooting>10</Shooting>
                </skills>
            </li>
            <li Class="Core40k.PawnRequirement_IncompatibleRanks">
                <ranks>
                    <li>BEWH_CustodesRankSagittarum</li>
                    <li>BEWH_CustodesRankWarden</li>
                </ranks>
            </li>
        </requirements>

        <statOffsets>
            <MoveSpeed>0.3</MoveSpeed>
            <MeleeDodgeChance>2</MeleeDodgeChance>
        </statOffsets>

        <givesAbilities>
            <li>BEWH_CustodesVenatariLeap</li>
        </givesAbilities>

        <rankTier>2</rankTier>

        <specialistRank>true</specialistRank>
    </Genes40k.ChapterRankDef>

    <!-- Allarus Custodian -->
    <Genes40k.ChapterRankDef>
        <defName>BEWH_CustodesRankAllarus</defName>
        <label>Allarus Custodian</label>
        <description>Allarus Custodians are veterans clad in Terminator plate, chosen for the bloodiest and most decisive fighting. Teleportation arrays carry them into the heart of the foe, where the battle is won or lost.</description>
        <rankIconPath>Placeholder</rankIconPath>
        <colonyLimitOfRank>(3, 6)</colonyLimitOfRank>

        <requirements>
            <li Class="Core40k.PawnRequirement_Skills">
                <skills>
                    <Melee>12</Melee>
                    <Shooting>12</Shooting>
                </skills>
            </li>
        </requirements>

        <statOffsets>
            <ArmorRating_Sharp>0.08</ArmorRating_Sharp>
            <ArmorRating_Blunt>0.08</ArmorRating_Blunt>
        </statOffsets>
        <statFactors>
            <MeleeDamageFactor>1.05</MeleeDamageFactor>
        </statFactors>

        <givesAbilities>
            <li>BEWH_CustodesAllarusTeleport</li>
            <li>BEWH_CustodesAllarusTeleportToVexilla</li>
        </givesAbilities>

        <rankTier>4</rankTier>

        <specialistRank>true</specialistRank>
    </Genes40k.ChapterRankDef>

    <!-- =Honour= -->
    <!-- Vexilus Praetor -->
    <Genes40k.ChapterRankDef>
        <defName>BEWH_CustodesRankVexilusPraetor</defName>
        <label>Vexilus Praetor</label>
        <description>The Vexilus Praetor carries a Vexilla, a sacred standard that is both a rallying point and a weapon in its own right. Its field generators turn aside the enemy's fire, and the sight of it steels every warrior who fights beneath it.</description>
        <rankIconPath>Placeholder</rankIconPath>

        <requirements>
            <li Class="Core40k.PawnRequirement_Skills">
                <skills><Social>10</Social></skills>
            </li>
            <li Class="Core40k.PawnRequirement_Traits">
                <traits>
                    <Nerves>2</Nerves>
                    <Nerves>1</Nerves>
                </traits>
                <oneAmong>true</oneAmong>
            </li>
        </requirements>

        <statFactors>
            <SocialImpact>1.2</SocialImpact>
        </statFactors>

        <givesVFEAbilities>
            <li>BEWH_CustodesVexillaDefensor</li>
        </givesVFEAbilities>

        <rankTier>2</rankTier>

        <specialistRank>true</specialistRank>
    </Genes40k.ChapterRankDef>

    <!-- =Shield Hosts= -->
    <!-- Aquilan Shield -->
    <Genes40k.ChapterRankDef>
        <defName>BEWH_CustodesRankAquilanShield</defName>
        <label>Aquilan Shield</label>
        <description>The Aquilan Shield guards the Imperium's mightiest servants: High Lords, Inquisitors and saints. Its Custodians will place themselves between their charge and any blow, and consider it no sacrifice at all.</description>
        <rankIconPath>Placeholder</rankIconPath>

        <requirements>
            <li Class="Core40k.PawnRequirement_Skills">
                <skills><Melee>12</Melee></skills>
            </li>
            <li Class="Core40k.PawnRequirement_IncompatibleRanks">
                <ranks>
                    <li>BEWH_CustodesRankSolarWatch</li>
                    <li>BEWH_CustodesRankShadowkeepers</li>
                    <li>BEWH_CustodesRankEmissaryImperatus</li>
                    <li>BEWH_CustodesRankDreadHost</li>
                </ranks>
            </li>
        </requirements>

        <statOffsets>
            <ArmorRating_Sharp>0.04</ArmorRating_Sharp>
            <ArmorRating_Blunt>0.04</ArmorRating_Blunt>
        </statOffsets>

        <givesAbilities>
            <li>BEWH_CustodesInterpose</li>
        </givesAbilities>

        <givesHediffs>
            <BEWH_CustodesAquilanWard>
                <initialSeverity>0.5</initialSeverity>
            </BEWH_CustodesAquilanWard>
        </givesHediffs>

        <rankTier>3</rankTier>

        <specialistRank>true</specialistRank>
    </Genes40k.ChapterRankDef>
    <!-- Solar Watch -->
    <Genes40k.ChapterRankDef>
        <defName>BEWH_CustodesRankSolarWatch</defName>
        <label>Solar Watch</label>
        <description>The Solar Watch guards the Sol System and the Throneworld itself. Its Custodians know every stone of the ground they defend, and fight there as nowhere else. Far from home, they are never quite at ease.</description>
        <rankIconPath>Placeholder</rankIconPath>

        <requirements>
            <li Class="Core40k.PawnRequirement_Skills">
                <skills><Shooting>12</Shooting></skills>
            </li>
            <li Class="Core40k.PawnRequirement_IncompatibleRanks">
                <ranks>
                    <li>BEWH_CustodesRankAquilanShield</li>
                    <li>BEWH_CustodesRankShadowkeepers</li>
                    <li>BEWH_CustodesRankEmissaryImperatus</li>
                    <li>BEWH_CustodesRankDreadHost</li>
                </ranks>
            </li>
        </requirements>

        <givesHediffs>
            <BEWH_CustodesSolarWatch>
                <initialSeverity>0.5</initialSeverity>
            </BEWH_CustodesSolarWatch>
        </givesHediffs>

        <rankTier>3</rankTier>

        <specialistRank>true</specialistRank>
    </Genes40k.ChapterRankDef>
    <!-- Shadowkeepers -->
    <Genes40k.ChapterRankDef>
        <defName>BEWH_CustodesRankShadowkeepers</defName>
        <label>Shadowkeepers</label>
        <description>The Shadowkeepers guard the Dark Cells beneath the Imperial Palace, where the most dangerous prisoners, artefacts and horrors of the Imperium are kept. They are patient, merciless jailers, and nothing has ever escaped them.</description>
        <rankIconPath>Placeholder</rankIconPath>

        <requirements>
            <li Class="Core40k.PawnRequirement_Skills">
                <skills><Social>8</Social></skills>
            </li>
            <li Class="Core40k.PawnRequirement_IncompatibleRanks">
                <ranks>
                    <li>BEWH_CustodesRankAquilanShield</li>
                    <li>BEWH_CustodesRankSolarWatch</li>
                    <li>BEWH_CustodesRankEmissaryImperatus</li>
                    <li>BEWH_CustodesRankDreadHost</li>
                </ranks>
            </li>
        </requirements>

        <statOffsets>
            <NegotiationAbility>0.15</NegotiationAbility>
            <TerrorSource MayRequire="Ludeon.RimWorld.Ideology">6</TerrorSource>
        </statOffsets>
        <statFactors>
            <SuppressionPower MayRequire="Ludeon.RimWorld.Ideology">1.25</SuppressionPower>
            <ActivitySuppressionRate MayRequire="Ludeon.RimWorld.Anomaly">1.3</ActivitySuppressionRate>
            <StudyEfficiency MayRequire="Ludeon.RimWorld.Anomaly">1.1</StudyEfficiency>
        </statFactors>

        <rankTier>3</rankTier>

        <specialistRank>true</specialistRank>
    </Genes40k.ChapterRankDef>
    <!-- Emissary Imperatus -->
    <Genes40k.ChapterRankDef>
        <defName>BEWH_CustodesRankEmissaryImperatus</defName>
        <label>Emissary Imperatus</label>
        <description>The Emissaries Imperatus speak with the Emperor's voice. They travel the galaxy as His envoys, and few rulers, however proud, can refuse a golden giant standing at their court.</description>
        <rankIconPath>Placeholder</rankIconPath>

        <requirements>
            <li Class="Core40k.PawnRequirement_Skills">
                <skills>
                    <Social>12</Social>
                    <Intellectual>8</Intellectual>
                </skills>
            </li>
            <li Class="Core40k.PawnRequirement_IncompatibleRanks">
                <ranks>
                    <li>BEWH_CustodesRankAquilanShield</li>
                    <li>BEWH_CustodesRankSolarWatch</li>
                    <li>BEWH_CustodesRankShadowkeepers</li>
                    <li>BEWH_CustodesRankDreadHost</li>
                </ranks>
            </li>
        </requirements>

        <statOffsets>
            <NegotiationAbility>0.2</NegotiationAbility>
            <TradePriceImprovement>0.05</TradePriceImprovement>
            <SocialImpact>0.15</SocialImpact>
        </statOffsets>
        <statFactors>
            <ReadingSpeed>1.25</ReadingSpeed>
        </statFactors>

        <customEffectDescriptions>
            <li>Goodwill gained with other factions is increased by 25% while an Emissary Imperatus is part of the colony.</li>
        </customEffectDescriptions>
        <modExtensions>
            <li Class="Genes40k.DefModExtension_GoodwillGainFactor">
                <factor>1.25</factor>
            </li>
        </modExtensions>

        <rankTier>3</rankTier>

        <specialistRank>true</specialistRank>
    </Genes40k.ChapterRankDef>
    <!-- Dread Host -->
    <Genes40k.ChapterRankDef>
        <defName>BEWH_CustodesRankDreadHost</defName>
        <label>Dread Host</label>
        <description>The Dread Host hunts the Emperor's most hated enemies: traitors, witches and the things that crawl from beyond the veil. When the Dread Host marks a quarry for excision, every one of its Custodians turns upon it.</description>
        <rankIconPath>Placeholder</rankIconPath>

        <requirements>
            <li Class="Core40k.PawnRequirement_Skills">
                <skills>
                    <Melee>12</Melee>
                    <Shooting>12</Shooting>
                </skills>
            </li>
            <li Class="Core40k.PawnRequirement_IncompatibleRanks">
                <ranks>
                    <li>BEWH_CustodesRankAquilanShield</li>
                    <li>BEWH_CustodesRankSolarWatch</li>
                    <li>BEWH_CustodesRankShadowkeepers</li>
                    <li>BEWH_CustodesRankEmissaryImperatus</li>
                </ranks>
            </li>
        </requirements>

        <statFactors>
            <PsychicSensitivity>0.9</PsychicSensitivity>
        </statFactors>

        <givesAbilities>
            <li>BEWH_CustodesMarkForExcision</li>
        </givesAbilities>

        <customEffectDescriptions>
            <li>Deals 50% more damage to targets marked for excision, or 100% more against psykers and unnatural entities.</li>
        </customEffectDescriptions>
        <modExtensions>
            <li Class="Genes40k.DefModExtension_MarkedTargetDamage">
                <damageFactor>1.5</damageFactor>
                <psykerOrEntityDamageFactor>2</psykerOrEntityDamageFactor>
            </li>
        </modExtensions>

        <rankTier>3</rankTier>

        <specialistRank>true</specialistRank>
    </Genes40k.ChapterRankDef>

</Defs>
