<?xml version="1.0" encoding="UTF-8"?>
<Defs>

    <!--
        Test trees for the framework's rank tree view (dashed "one among" lines and cross-category bridges).
        Local only: this folder is excluded from the Workshop upload. Both categories need an impossible age,
        so they only open with god mode on.

        Test A: A1 -> A2 / A3 -> A4 (one among A2, A3: dashed) -> Shared (portal into Test B, declared here)
                A3 -> Relay (entrance from Test B, implied by Test B's portal) -> A6
        Test B: B1 -> Shared (entrance from Test A, implied) -> B2..B5 (four, so the portal in Test A shows "+1 more")
                B2..B4 -> B6 (one among, dashed) -> Relay (portal into Test A with a fixed ghost offset)
                B5 -> B7 (one among with a single entry: solid)
    -->

    <Core40k.RankDef Name="BEWH_TestRankBase" Abstract="True">
        <description>Test rank for the rank tree view. Does nothing.</description>
        <rankTier>0</rankTier>
    </Core40k.RankDef>

