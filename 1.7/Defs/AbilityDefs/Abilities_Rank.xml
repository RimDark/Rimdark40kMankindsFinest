<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <!-- Remove rank ability -->
    <AbilityDef Name="BEWH_StripRank" Abstract="True">
        <cooldownTicksRange>15000</cooldownTicksRange>
        <iconPath>UI/Abilities/BEWH_Ability_RankStripRank</iconPath>
        <jobDef>CastAbilityOnThingMelee</jobDef>
        <displayGizmoWhileUndrafted>True</displayGizmoWhileUndrafted>
        <disableGizmoWhileUndrafted>False</disableGizmoWhileUndrafted>
        <targetRequired>true</targetRequired>
        <showWhenDrafted>true</showWhenDrafted>
        <hostile>false</hostile>
        <verbProperties>
            <verbClass>Verb_CastAbilityTouch</verbClass>
            <range>-1</range>
            <warmupTime>0.25</warmupTime>
            <soundCast>BEWH_SFX_StripRanks</soundCast>
            <targetParams>
                <canTargetPawns>true</canTargetPawns>
                <canTargetBuildings>false</canTargetBuildings>
                <canTargetAnimals>false</canTargetAnimals>
                <canTargetMechs>false</canTargetMechs>
                <canTargetBloodfeeders>false</canTargetBloodfeeders>
                <canTargetCorpses>false</canTargetCorpses>
            </targetParams>
        </verbProperties>
    </AbilityDef>

    <AbilityDef ParentName="BEWH_StripRank">
        <defName>BEWH_StripRanks</defName>
        <label>Strip ranks</label>
        <description>Target an underperforming or insubordinate ally, demoting and stripping them of rank, effectively resetting their place in the hierarchy.\nWorks on astartes ranks.</description>
        <comps>
            <li Class="Core40k.CompProperties_ResetRanks">
                <rankCategoryDef>BEWH_AstartesRankCategory</rankCategoryDef>
                <ownRankAsTier>true</ownRankAsTier>
            </li>
        </comps>
    </AbilityDef>

    <AbilityDef ParentName="BEWH_StripRank">
        <defName>BEWH_StripRanksCustodes</defName>
        <label>Strip ranks</label>
        <description>Target an underperforming or insubordinate ally, demoting and stripping them of rank, effectively resetting their place in the hierarchy.\nWorks on custodes ranks.</description>
        <comps>
            <li Class="Core40k.CompProperties_ResetRanks">
                <rankCategoryDef>BEWH_CustodesRankCategory</rankCategoryDef>
                <ownRankAsTier>true</ownRankAsTier>
            </li>
        </comps>
    </AbilityDef>


    <!-- Chaplain: Oath of Service -->
    <AbilityDef>
        <defName>BEWH_ChaplainOathOfService</defName>
        <label>Oath of service</label>
        <description>Hear a mortal colonist's oath of service, binding them to the Chapter as a serf for life.\nThe serf trait is permanent, and a serf can never receive gene-seed.</description>
        <cooldownTicksRange>180000</cooldownTicksRange>
        <iconPath>UI/Abilities/BEWH_AbilityChaplainSFaith</iconPath>
        <jobDef>CastAbilityOnThingMelee</jobDef>
        <displayGizmoWhileUndrafted>True</displayGizmoWhileUndrafted>
        <disableGizmoWhileUndrafted>False</disableGizmoWhileUndrafted>
        <targetRequired>true</targetRequired>
        <showWhenDrafted>true</showWhenDrafted>
        <hostile>false</hostile>
        <verbProperties>
            <verbClass>Verb_CastAbilityTouch</verbClass>
            <range>-1</range>
            <warmupTime>3</warmupTime>
            <targetParams>
                <canTargetPawns>true</canTargetPawns>
                <canTargetBuildings>false</canTargetBuildings>
                <canTargetAnimals>false</canTargetAnimals>
                <canTargetMechs>false</canTargetMechs>
            </targetParams>
        </verbProperties>
        <comps>
            <li Class="Genes40k.CompProperties_AbilityOathOfService" />
        </comps>
    </AbilityDef>


    <!-- Ancient: Raise Legion Banner -->
    <VEF.Abilities.AbilityDef>
        <defName>BEWH_RaiseChapterBanner</defName>
        <label>Raise Legion Standard</label>
        <description>Raise the Legion's sacred banner, inspiring nearby battle brothers with unwavering courage and strength. While the banner is raised, they fight with increased morale and unparalleled determination, embodying the glory of their legion.</description>
        <iconPath>UI/Abilities/BEWH_Ability_RaiseChapterBanner</iconPath>
        <abilityClass>Genes40k.Ability_PlaceBanner</abilityClass>
        <needsTicking>true</needsTicking>
        <requireLineOfSight>true</requireLineOfSight>
        <cooldownTime>60000</cooldownTime>
        <range>1.9</range>
        <castTime>30</castTime>
        <targetMode>Location</targetMode>
        <warmupSound>BEWH_SFX_BannerWarmUp</warmupSound>
        <castSound>BEWH_SFX_BannerCast</castSound>
        <modExtensions>
            <li Class="Genes40k.DefModExtension_PlaceBanner">
                <bannerType>BEWH_AncientChapterBanner</bannerType>
            </li>
        </modExtensions>
    </VEF.Abilities.AbilityDef>


    <!-- Librarian: Quickening -->
    <AbilityDef ParentName="BEWH_SelfTargetAbilities">
        <defName>BEWH_LibrarianQuickening</defName>
        <label>Quickening</label>
        <description>The psyker taps into precognitive abilities that greatly increase his speed and awareness. With heightened reflexes and foresight, he can anticipate enemy movements and strike with unparalleled speed, outmaneuvering opponents before they can react.</description>
        <iconPath>UI/Abilities/BEWH_AbilityLibrarianQuickening</iconPath>
        <cooldownTicksRange>90000</cooldownTicksRange>
        <statBases>
            <Ability_Duration>125</Ability_Duration>
        </statBases>
        <verbProperties>
            <soundCast>BEWH_SFX_Quickening</soundCast>
        </verbProperties>
        <comps>
            <li Class="CompProperties_AbilityGiveHediff">
                <compClass>CompAbilityEffect_GiveHediff</compClass>
                <hediffDef>BEWH_LibrarianQuickeningBuff</hediffDef>
                <onlyApplyToSelf>True</onlyApplyToSelf>
                <replaceExisting>true</replaceExisting>
            </li>
        </comps>
    </AbilityDef>

    <!-- Librarian: Wave of Lethargy -->
    <AbilityDef>
        <defName>BEWH_LibrarianWaveOfLethargy</defName>
        <label>Wave of Lethargy</label>
        <description>Unleashes a psychic wave of exhaustion that drains the strength of all enemies in its path. Those caught in the wave are slowed and overwhelmed, leaving them sluggish and vulnerable to subsequent attacks.</description>
        <iconPath>UI/Abilities/BEWH_AbilityLibrarianWaveOfLethargy</iconPath>
        <cooldownTicksRange>120000</cooldownTicksRange>
        <statBases>
            <Ability_Duration>125</Ability_Duration>
        </statBases>
        <aiCanUse>true</aiCanUse>
        <warmupStartSound>BEWH_SFX_HolyBlastWarmup</warmupStartSound>
        <verbProperties>
            <verbClass>Verb_CastAbility</verbClass>
            <range>9.9</range>
            <warmupTime>1</warmupTime>
            <soundCast>BEWH_SFX_WaveOfLethargy</soundCast>
            <targetParams>
                <canTargetLocations>true</canTargetLocations>
            </targetParams>
        </verbProperties>
        <comps>
            <li Class="Core40k.CompProperties_AbilityWaveAttack">
                <hediffDef>BEWH_ChiefLibrarianWaveOfLethargyDebuff</hediffDef>
                <effecterDef>FoamSpray_Directional</effecterDef>                <!-- Change this to something else (Maybe look at effectDef unfathomable gaze from chaos mod) -->
                <range>9.9</range>
                <lineWidthEnd>14</lineWidthEnd>
                <stunTicks>50</stunTicks>
                <replaceExisting>true</replaceExisting>
            </li>
        </comps>
    </AbilityDef>


    <!-- Apothecary: Emergency Aid -->
    <AbilityDef>
        <defName>BEWH_ApothecaryEmergencyAid</defName>
        <label>Emergency Aid</label>
        <description>Provides emergency treatment to a downed or bedridden pawn, administering stimulants to ease pain and speed healing. The quick, precise care tends to all the pawn's wounds, providing a slight but immediate recovery.</description>
        <cooldownTicksRange>5000</cooldownTicksRange>
        <iconPath>UI/Abilities/BEWH_AbilityApothecaryEAid</iconPath>
        <jobDef>CastAbilityOnThingMelee</jobDef>
        <displayGizmoWhileUndrafted>True</displayGizmoWhileUndrafted>
        <disableGizmoWhileUndrafted>False</disableGizmoWhileUndrafted>
        <targetRequired>true</targetRequired>
        <showWhenDrafted>true</showWhenDrafted>
        <hostile>false</hostile>
        <statBases>
            <Ability_Duration>50</Ability_Duration>
        </statBases>
        <verbProperties>
            <verbClass>Verb_CastAbilityTouch</verbClass>
            <range>-1</range>
            <warmupTime>1</warmupTime>
            <soundCast>BEWH_SFX_EmergencyAid</soundCast>
            <targetParams>
                <canTargetPawns>true</canTargetPawns>
                <canTargetBuildings>false</canTargetBuildings>
                <canTargetAnimals>false</canTargetAnimals>
                <canTargetMechs>false</canTargetMechs>
                <canTargetBloodfeeders>false</canTargetBloodfeeders>
                <canTargetCorpses>false</canTargetCorpses>
            </targetParams>
        </verbProperties>
        <comps>
            <li Class="Core40k.CompProperties_AbilityHealAndTend">
                <healAmount>1~2</healAmount>
            </li>
            <li Class="CompProperties_AbilityGiveHediff">
                <compClass>CompAbilityEffect_GiveHediff</compClass>
                <hediffDef>BEWH_ApothecaryStimulantsBuff</hediffDef>
                <replaceExisting>true</replaceExisting>
            </li>
        </comps>
    </AbilityDef>


    <!-- Chaplain: Inspire -->
    <VEF.Abilities.AbilityDef>
        <defName>BEWH_ChaplainInspire</defName>
        <label>Inspire</label>
        <description>The Chaplain rallies his allies with strong, heartfelt words, filling them with an unshakable faith in their common cause.</description>
        <iconPath>UI/Abilities/BEWH_AbilityChaplainInspire</iconPath>
        <abilityClass>Genes40k.Ability_Inspire</abilityClass>
        <cooldownTime>90000</cooldownTime>
        <castTime>200</castTime>
        <durationTime>5000</durationTime>
        <range>4.9</range>
        <radius>4.9</radius>
        <targetMode>Self</targetMode>
        <worldTargeting>false</worldTargeting>
        <needsTicking>false</needsTicking>
        <showGizmoOnWorldView>false</showGizmoOnWorldView>
    </VEF.Abilities.AbilityDef>


    <!-- Captain: Command -->
    <AbilityDef>
        <defName>BEWH_CaptainsOrder</defName>
        <label>Captain's Order</label>
        <description>The captain issues a powerful command that rallies nearby allies and increases their combat effectiveness. The command increases their strength, precision, and morale, allowing them to fight with greater coordination and ferocity. The effect remains attached to the caster for 24 hours.</description>
        <iconPath>UI/Abilities/BEWH_AbilityCaptainsOrder</iconPath>
        <jobDef>CastAbilityOnThing</jobDef>
        <targetRequired>False</targetRequired>
        <canUseAoeToGetTargets>False</canUseAoeToGetTargets>
        <stunTargetWhileCasting>True</stunTargetWhileCasting>
        <showPsycastEffects>False</showPsycastEffects>
        <sendMessageOnCooldownComplete>true</sendMessageOnCooldownComplete>
        <displayGizmoWhileUndrafted>True</displayGizmoWhileUndrafted>
        <disableGizmoWhileUndrafted>False</disableGizmoWhileUndrafted>
        <statBases>
            <Ability_Duration>1000</Ability_Duration>
            <Ability_EffectRadius>11.9</Ability_EffectRadius>
        </statBases>
        <verbProperties>
            <verbClass>Verb_CastAbility</verbClass>
            <warmupTime>0.5</warmupTime>
            <range>11.9</range>
            <drawAimPie>False</drawAimPie>
            <requireLineOfSight>False</requireLineOfSight>
            <soundCast>BEWH_SFX_CaptainsOrder</soundCast>
            <targetParams>
                <canTargetSelf>true</canTargetSelf>
                <canTargetPawns>false</canTargetPawns>
                <canTargetBuildings>false</canTargetBuildings>
                <canTargetAnimals>false</canTargetAnimals>
                <canTargetHumans>false</canTargetHumans>
                <canTargetMechs>false</canTargetMechs>
            </targetParams>
        </verbProperties>
        <comps>
            <li Class="CompProperties_AbilityGiveHediff">
                <compClass>CompAbilityEffect_GiveHediff</compClass>
                <hediffDef>BEWH_CaptainsOrderBuff</hediffDef>
                <onlyBrain>True</onlyBrain>
                <onlyApplyToSelf>True</onlyApplyToSelf>
                <replaceExisting>true</replaceExisting>
            </li>
        </comps>
    </AbilityDef>


    <!-- Chapter Master: Steel Rain -->
    <VEF.Abilities.AbilityDef>
        <defName>BEWH_ChapterMasterSteelRain</defName>
        <label>Steel Rain III</label>
        <description>Call down a barrage of bolter-equipped drop pods, each carrying a squad of Space Marines. The pods crash onto the battlefield, quickly deploying their deadly occupants to overwhelm enemies with a storm of steel and gunfire.</description>
        <iconPath>UI/Abilities/BEWH_AbilitySteelRainIII</iconPath>
        <abilityClass>Genes40k.Ability_SteelRain</abilityClass>
        <castTime>100</castTime>
        <range>40.9</range>
        <radius>15.9</radius>
        <cooldownTime>240000</cooldownTime>
        <targetMode>Location</targetMode>
        <modExtensions>
            <li Class="Genes40k.DefModExtension_DropPod">
                <usePlayerColours>true</usePlayerColours>
                <dropPodAmount>3</dropPodAmount>
                <marinesToSpawn>4</marinesToSpawn>
                <fromFaction>BEWH_OffworldMarinesFaction</fromFaction>
                <innerThing>BEWH_SteelRainDropPodBuilding</innerThing>
                <skyFaller>BEWH_SteelRainDropPodSkyfaller</skyFaller>
            </li>
        </modExtensions>
    </VEF.Abilities.AbilityDef>


    <!-- Chapter Ancient: Steel Rain II -->
    <VEF.Abilities.AbilityDef>
        <defName>BEWH_Ability_SteelRain_2</defName>
        <label>Steel Rain II</label>
        <description>Call in two bolter-equipped drop pods, each carrying a Space Marine squad. The pods crash onto the battlefield, quickly deploying their deadly occupants to overwhelm enemies with a storm of steel and gunfire.</description>
        <iconPath>UI/Abilities/BEWH_AbilitySteelRainII</iconPath>
        <abilityClass>Genes40k.Ability_SteelRain</abilityClass>
        <castTime>100</castTime>
        <range>40.9</range>
        <radius>15.9</radius>
        <cooldownTime>240000</cooldownTime>
        <targetMode>Location</targetMode>
        <modExtensions>
            <li Class="Genes40k.DefModExtension_DropPod">
                <usePlayerColours>true</usePlayerColours>
                <dropPodAmount>2</dropPodAmount>
                <marinesToSpawn>4</marinesToSpawn>
                <fromFaction>BEWH_OffworldMarinesFaction</fromFaction>
                <innerThing>BEWH_SteelRainDropPodBuilding</innerThing>
                <skyFaller>BEWH_SteelRainDropPodSkyfaller</skyFaller>
            </li>
        </modExtensions>
    </VEF.Abilities.AbilityDef>


    <!-- Master of the Forge: Steel Rain I -->
    <VEF.Abilities.AbilityDef>
        <defName>BEWH_Ability_SteelRain_1</defName>
        <label>Steel Rain I</label>
        <description>Call down a single bolter-equipped drop pods, each carrying a squad of Space Marines. The pods crash onto the battlefield, quickly deploying their deadly occupants to overwhelm enemies with a storm of steel and gunfire.</description>
        <iconPath>UI/Abilities/BEWH_AbilitySteelRainI</iconPath>
        <abilityClass>Genes40k.Ability_SteelRain</abilityClass>
        <castTime>100</castTime>
        <range>40.9</range>
        <radius>15.9</radius>
        <cooldownTime>240000</cooldownTime>
        <targetMode>Location</targetMode>
        <modExtensions>
            <li Class="Genes40k.DefModExtension_DropPod">
                <usePlayerColours>true</usePlayerColours>
                <dropPodAmount>1</dropPodAmount>
                <marinesToSpawn>4</marinesToSpawn>
                <fromFaction>BEWH_OffworldMarinesFaction</fromFaction>
                <innerThing>BEWH_SteelRainDropPodBuilding</innerThing>
                <skyFaller>BEWH_SteelRainDropPodSkyfaller</skyFaller>
            </li>
        </modExtensions>
    </VEF.Abilities.AbilityDef>

    <!-- Custodes: Interpose (Aquilan Shield) -->
    <AbilityDef>
        <defName>BEWH_CustodesInterpose</defName>
        <label>Interpose</label>
        <description>Stand guard over an ally. For 30 seconds, half of all violent damage they take is borne by this Custodian instead, as long as he stays on his feet and within 15 cells of them.</description>
        <iconPath>UI/Abilities/BEWH_AbilityCustodesInterpose</iconPath>
        <cooldownTicksRange>60000</cooldownTicksRange>
        <jobDef>CastAbilityOnThing</jobDef>
        <displayGizmoWhileUndrafted>True</displayGizmoWhileUndrafted>
        <disableGizmoWhileUndrafted>False</disableGizmoWhileUndrafted>
        <targetRequired>true</targetRequired>
        <hostile>false</hostile>
        <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
        <verbProperties>
            <verbClass>Verb_CastAbility</verbClass>
            <range>6.9</range>
            <warmupTime>0.25</warmupTime>
            <requireLineOfSight>true</requireLineOfSight>
            <targetParams>
                <canTargetSelf>false</canTargetSelf>
                <canTargetPawns>true</canTargetPawns>
                <canTargetBuildings>false</canTargetBuildings>
                <canTargetAnimals>false</canTargetAnimals>
                <canTargetMechs>false</canTargetMechs>
                <neverTargetHostileFaction>true</neverTargetHostileFaction>
            </targetParams>
        </verbProperties>
        <comps>
            <li Class="CompProperties_AbilityGiveHediff">
                <compClass>CompAbilityEffect_GiveHediff</compClass>
                <hediffDef>BEWH_CustodesInterposed</hediffDef>
                <replaceExisting>true</replaceExisting>
                <durationSecondsOverride>30~30</durationSecondsOverride>
            </li>
        </comps>
    </AbilityDef>

    <!-- Custodes: Mark for Excision (Dread Host) -->
    <AbilityDef>
        <defName>BEWH_CustodesMarkForExcision</defName>
        <label>Mark for excision</label>
        <description>Mark an enemy for death. For 60 seconds, every Custodian of the Dread Host deals far more damage to it.\nThe mark is shared: using it puts every Dread Host's mark on cooldown.</description>
        <iconPath>UI/Abilities/BEWH_AbilityCustodesMarkForExcision</iconPath>
        <cooldownTicksRange>15000</cooldownTicksRange>
        <jobDef>CastAbilityOnThing</jobDef>
        <targetRequired>true</targetRequired>
        <hostile>true</hostile>
        <verbProperties>
            <verbClass>Verb_CastAbility</verbClass>
            <range>29.9</range>
            <warmupTime>0.5</warmupTime>
            <requireLineOfSight>true</requireLineOfSight>
            <targetParams>
                <canTargetSelf>false</canTargetSelf>
                <canTargetPawns>true</canTargetPawns>
                <canTargetBuildings>false</canTargetBuildings>
                <canTargetLocations>false</canTargetLocations>
            </targetParams>
        </verbProperties>
        <comps>
            <li Class="CompProperties_AbilityGiveHediff">
                <compClass>CompAbilityEffect_GiveHediff</compClass>
                <hediffDef>BEWH_DreadHostMark</hediffDef>
                <replaceExisting>true</replaceExisting>
                <durationSecondsOverride>60~60</durationSecondsOverride>
            </li>
            <li Class="Genes40k.CompProperties_AbilitySharedCooldown" />
        </comps>
    </AbilityDef>

    <!-- Custodes: Venatari Leap -->
    <AbilityDef>
        <defName>BEWH_CustodesVenatariLeap</defName>
        <label>Venatari leap</label>
        <description>Ignite the jump pack and leap to a nearby location.</description>
        <iconPath>UI/Abilities/BEWH_AbilityCustodesVenatariLeap</iconPath>
        <cooldownTicksRange>1800</cooldownTicksRange>
        <hostile>false</hostile>
        <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
        <verbProperties>
            <verbClass>Verb_CastAbilityJump</verbClass>
            <label>leap</label>
            <violent>false</violent>
            <forceNormalTimeSpeed>false</forceNormalTimeSpeed>
            <warmupTime>0.5</warmupTime>
            <range>14.9</range>
            <requireLineOfSight>true</requireLineOfSight>
            <soundCast>Longjump_Jump</soundCast>
            <soundLanding>Longjump_Land</soundLanding>
            <targetParams>
                <canTargetLocations>true</canTargetLocations>
                <canTargetPawns>false</canTargetPawns>
                <canTargetBuildings>false</canTargetBuildings>
            </targetParams>
        </verbProperties>
        <jobDef>CastJump</jobDef>
    </AbilityDef>

    <!-- Custodes: Vexilla Defensor (Vexilus Praetor) -->
    <VEF.Abilities.AbilityDef>
        <defName>BEWH_CustodesVexillaDefensor</defName>
        <label>Raise Vexilla Defensor</label>
        <description>Plant a Vexilla Defensor. Its field generators turn aside shots and blasts, reducing ranged and explosive damage taken by allies within 12 cells by 20%. Allarus Custodians can teleport to it while it stands.</description>
        <iconPath>UI/Abilities/BEWH_AbilityCustodesVexillaDefensor</iconPath>
        <abilityClass>Genes40k.Ability_PlaceBanner</abilityClass>
        <needsTicking>true</needsTicking>
        <requireLineOfSight>true</requireLineOfSight>
        <cooldownTime>60000</cooldownTime>
        <range>1.9</range>
        <castTime>30</castTime>
        <targetMode>Location</targetMode>
        <warmupSound>BEWH_SFX_BannerWarmUp</warmupSound>
        <castSound>BEWH_SFX_BannerCast</castSound>
        <modExtensions>
            <li Class="Genes40k.DefModExtension_PlaceBanner">
                <bannerType>BEWH_CustodesVexillaDefensorBanner</bannerType>
            </li>
        </modExtensions>
    </VEF.Abilities.AbilityDef>

    <!-- Custodes: Allarus teleport (shared cooldown) -->
    <AbilityGroupDef>
        <defName>BEWH_CustodesAllarusTeleportGroup</defName>
        <cooldownTicks>120000</cooldownTicks>
    </AbilityGroupDef>

    <AbilityDef>
        <defName>BEWH_CustodesAllarusTeleport</defName>
        <label>Teleport strike</label>
        <description>Teleport to a location within range. Enemies right beside the landing point are briefly stunned.\nShares its cooldown with Teleport to Vexilla.</description>
        <iconPath>UI/Abilities/BEWH_AbilityCustodesTeleportStrike</iconPath>
        <groupDef>BEWH_CustodesAllarusTeleportGroup</groupDef>
        <targetRequired>true</targetRequired>
        <hostile>false</hostile>
        <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
        <verbProperties>
            <verbClass>Verb_CastAbility</verbClass>
            <range>24.9</range>
            <warmupTime>1</warmupTime>
            <requireLineOfSight>false</requireLineOfSight>
            <targetParams>
                <canTargetLocations>true</canTargetLocations>
                <canTargetPawns>false</canTargetPawns>
                <canTargetBuildings>false</canTargetBuildings>
                <canTargetSelf>false</canTargetSelf>
            </targetParams>
        </verbProperties>
        <comps>
            <li Class="Genes40k.CompProperties_AbilityTeleportStrike">
                <stunRadius>1.9</stunRadius>
                <stunTicks>90</stunTicks>
            </li>
        </comps>
    </AbilityDef>

    <AbilityDef ParentName="BEWH_SelfTargetAbilities">
        <defName>BEWH_CustodesAllarusTeleportToVexilla</defName>
        <label>Teleport to Vexilla</label>
        <description>Teleport beside the nearest Vexilla Defensor on this map, however far away it stands. Enemies right beside the landing point are briefly stunned.\nShares its cooldown with Teleport strike.</description>
        <iconPath>UI/Abilities/BEWH_AbilityCustodesTeleportToVexilla</iconPath>
        <groupDef>BEWH_CustodesAllarusTeleportGroup</groupDef>
        <verbProperties>
            <warmupTime>1</warmupTime>
        </verbProperties>
        <comps>
            <li Class="Genes40k.CompProperties_AbilityTeleportStrike">
                <beaconDef>BEWH_CustodesVexillaDefensorBanner</beaconDef>
                <stunRadius>1.9</stunRadius>
                <stunTicks>90</stunTicks>
            </li>
        </comps>
    </AbilityDef>

</Defs>